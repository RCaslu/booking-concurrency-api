# Copie para .env e ajuste. Todas são opcionais: sem .env, os valores abaixo são os padrões.
# O docker compose lê o .env automaticamente; a aplicação (pydantic-settings) também.

# Credenciais do Postgres usadas pelos serviços db e db-test (só para desenvolvimento local)
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# Portas expostas no host
API_PORT=8020
DB_PORT=5432
DB_TEST_PORT=5433

# Só para rodar fora de container (uvicorn/pytest no host)
DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5432/booking
TEST_DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5433/booking_test
