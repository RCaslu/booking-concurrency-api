# Copie para .env e ajuste. Todas são opcionais: sem .env, os valores abaixo são os padrões.
# O docker compose lê o .env automaticamente; a aplicação (pydantic-settings) também.

# Credenciais do Postgres usadas pelos serviços db e db-test (só para desenvolvimento local).
# Use só caracteres seguros em URL (letras, números, - e _): elas entram direto na DATABASE_URL.
# Trocar depois que o volume pgdata existe exige 'docker compose down -v' (o Postgres só lê isso na criação).
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking
POSTGRES_DB=booking

# Portas expostas no host
API_PORT=8020
DB_PORT=5432
DB_TEST_PORT=5433

# Só para rodar a API fora de container (uvicorn no host)
DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5432/booking

# TEST_DATABASE_URL NÃO é lida deste arquivo: o pytest a lê do ambiente do shell.
# Para rodar os testes no host com outra porta: export TEST_DATABASE_URL=postgresql+psycopg://booking:booking@localhost:5434/booking_test
